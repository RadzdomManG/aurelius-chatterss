{
  "name": "AIJob",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "trigger_message_uuid": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled",
        "needs_approval",
        "dead_letter"
      ],
      "default": "pending"
    },
    "attempts": {
      "type": "integer",
      "default": 0
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "error_code": {
      "type": "string",
      "description": "Structured error code from the error catalog (e.g. FANVUE_SEND_FAILED)"
    },
    "reply_text": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "message_persisted_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "fanvue_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "ppv_cents": {
      "type": "integer"
    },
    "content_set_id": {
      "type": "string",
      "description": "PPV content set attached to this job's offer, so the operator can see what was sent"
    },
    "attached_media_uuids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string",
      "enum": [
        "ingested",
        "context_loaded",
        "ai_generating",
        "ai_generated",
        "anti_repetition",
        "sending",
        "sent",
        "completed"
      ]
    }
  },
  "required": [
    "conversation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}