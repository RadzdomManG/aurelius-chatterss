{
  "name": "Message",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "external_uuid": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "fan",
        "creator",
        "ai",
        "system"
      ]
    },
    "body": {
      "type": "string"
    },
    "media": {
      "type": "array"
    },
    "ppv_cents": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "enum": [
        "fanvue",
        "manual",
        "ai",
        "sync",
        "webhook",
        "ai_presence_greet"
      ],
      "default": "fanvue"
    },
    "send_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "sent"
    },
    "unsend_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "unsent",
        "cancelled"
      ],
      "default": "sent",
      "description": "Lifecycle of an auto-unsendable message. 'pending' = waiting for the 30-min unsend window; 'cancelled' = fan replied/read so unsend was aborted; 'unsent' = successfully deleted on Fanvue; 'sent' = normal message, never unsendable."
    },
    "pending_unsend_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this message should be unsent (deleted on Fanvue) if the fan hasn't replied. Only set on ai_presence_greet messages."
    },
    "fanvue_created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "conversation_id",
    "sender_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}