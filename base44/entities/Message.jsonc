{
  "name": "Message",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "external_uuid": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "fan",
        "creator",
        "ai",
        "system"
      ]
    },
    "body": {
      "type": "string"
    },
    "media": {
      "type": "array"
    },
    "ppv_cents": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "enum": [
        "fanvue",
        "manual",
        "ai",
        "sync",
        "webhook"
      ],
      "default": "fanvue"
    },
    "send_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "sent"
    },
    "fanvue_created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "conversation_id",
    "sender_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}