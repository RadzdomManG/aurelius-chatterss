{
  "name": "Rule",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "new_subscriber",
        "new_message",
        "high_spender",
        "inactive_fan",
        "first_message"
      ]
    },
    "trigger_conditions": {
      "type": "object"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "send_message",
        "send_ppv",
        "pause_ai",
        "tag_fan",
        "notify"
      ]
    },
    "action_payload": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "creator_profile_id",
    "name",
    "trigger",
    "action_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}