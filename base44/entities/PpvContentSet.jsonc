{
  "name": "PpvContentSet",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Internal label for the operator"
    },
    "description": {
      "type": "string",
      "description": "Operator's caption of what is in the set \u2014 the AI reads this to pick the best-matching set and to write its own teaser"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keyword tags for content matching. When a fan requests specific content (e.g. 'dildo'), the AI matches the fan's words to a set's tags first, falling back to the description."
    },
    "media_uuids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 5,
      "description": "Fanvue vault media UUIDs to attach so the content is locked behind the paywall"
    },
    "suggested_price_cents": {
      "type": "integer",
      "default": 1200,
      "description": "Suggested price \u2014 the AI ladder remains the final authority; this is a hint only"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "creator_profile_id",
    "name",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}