{
  "name": "VaultMedia",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "external_uuid": {
      "type": "string",
      "description": "Fanvue vault media UUID used to attach to PPV messages"
    },
    "folder_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "main_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "ready"
    },
    "duration_seconds": {
      "type": "number"
    },
    "price_cents": {
      "type": "integer",
      "default": 0,
      "description": "The media's own vault price in cents (from Fanvue pricing.USD.price or priceCents). 0 = no paywall on the media itself."
    },
    "access_state": {
      "type": "string",
      "enum": [
        "LOCKED",
        "FREE",
        "UNKNOWN"
      ],
      "default": "FREE",
      "description": "Normalized Fanvue media access state. LOCKED = positively confirmed paid/paywalled content (price > 0). FREE = no paywall. UNKNOWN = isLocked but no confirmed price. Only LOCKED is PPV-eligible."
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "False when the media is deleted, processing, or otherwise unavailable (status !== ready)."
    },
    "eligible_for_paid_ppv": {
      "type": "boolean",
      "default": false,
      "description": "THE single source of truth for PPV candidacy. True ONLY when access_state=LOCKED AND is_available. Free, unknown, and unavailable media are ALWAYS false. The automatic PPV engine must behave as if false media does not exist."
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "creator_profile_id",
    "external_uuid"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}