{
  "name": "UsageRecord",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "description": "Billing month key in YYYY-MM format (e.g. 2026-09). One record per org per month."
    },
    "ai_jobs_processed": {
      "type": "integer",
      "default": 0,
      "description": "Count of AI jobs that reached the processing stage this month \u2014 the primary metered metric for plan limits."
    },
    "messages_sent": {
      "type": "integer",
      "default": 0,
      "description": "Total messages sent via Fanvue this month (AI + manual + Copilot)."
    },
    "creators_connected": {
      "type": "integer",
      "default": 0,
      "description": "Snapshot of distinct CreatorProfile records belonging to this org."
    },
    "ppv_offers_sent": {
      "type": "integer",
      "default": 0,
      "description": "Count of PPV offers sent this month."
    },
    "reset_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record's counters were last reset (start of the billing month)."
    }
  },
  "required": [
    "organization_id",
    "month"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}