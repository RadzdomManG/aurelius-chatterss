{
  "name": "PpvOfferTracking",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "fan_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "content_set_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string",
      "description": "Fanvue message UUID of the sent PPV bubble, used to reconcile unlocks against spending insights"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "price_cents": {
      "type": "integer"
    },
    "purchased": {
      "type": "boolean",
      "default": false,
      "description": "True once the fan unlocked this offer; until then the set stays re-offerable on later turns."
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "creator_profile_id",
    "fan_id",
    "content_set_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}