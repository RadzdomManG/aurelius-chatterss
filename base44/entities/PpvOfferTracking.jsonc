{
  "name": "PpvOfferTracking",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "fan_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "content_set_id": {
      "type": "string",
      "description": "PpvContentSet id when source = set; null for vault offers"
    },
    "message_id": {
      "type": "string",
      "description": "Fanvue message UUID of the sent PPV bubble, used to reconcile unlocks against spending insights"
    },
    "media_uuids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The exact vault media UUIDs attached to this offer, used to dedup so a fan never receives the same locked media twice"
    },
    "source": {
      "type": "string",
      "enum": [
        "set",
        "vault"
      ],
      "default": "set",
      "description": "set = curated PpvContentSet bundle; vault = auto-selected from synced Fanvue vault"
    },
    "folder_name": {
      "type": "string",
      "description": "Vault folder the media was drawn from (auto_vault mode)"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "price_cents": {
      "type": "integer",
      "description": "The actual price sent to the fan for THIS record. For a base offer this is the base price; for a negotiation re-offer this is the persona-chosen negotiated price."
    },
    "offer_type": {
      "type": "string",
      "enum": [
        "base",
        "rescue",
        "negotiation"
      ],
      "default": "base",
      "description": "base = the original PPV offer; rescue = retired discounted re-offer; negotiation = a persona-priced re-offer of the SAME content when the fan counters the base offer's price (bypasses the inter-offer cooldown)."
    },
    "parent_offer_id": {
      "type": "string",
      "description": "For negotiation/rescue offers, the id of the base PpvOfferTracking this re-offers. null for base offers."
    },
    "base_price_cents": {
      "type": "integer",
      "description": "The original base price (present on base, rescue, and negotiation records)."
    },
    "ladder_level": {
      "type": "integer",
      "description": "The fan's ladder level at the time this base offer was sent."
    },
    "rescue_eligible": {
      "type": "boolean",
      "default": true,
      "description": "True when a rescue may be scheduled for this base offer."
    },
    "rescue_price_cents": {
      "type": "integer",
      "description": "The discounted price for the rescue offer (base_price - rescue_discount). May be below $12 down to $7."
    },
    "rescue_scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the rescue is due to fire (base sent time + random 5-10 min)."
    },
    "rescue_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "rescue_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "cancelled",
        "sent",
        "purchased",
        "failed"
      ],
      "default": "none",
      "description": "Lifecycle of the rescue for this base offer. none = no rescue scheduled; pending = waiting for the timer; cancelled = fan purchased base or offer superseded; sent = rescue delivered; purchased = rescue was bought; failed = rescue sent but not purchased and cycle closed."
    },
    "base_status": {
      "type": "string",
      "enum": [
        "sent",
        "purchased",
        "failed"
      ],
      "default": "sent"
    },
    "purchase_type": {
      "type": "string",
      "enum": [
        "base",
        "rescue",
        "negotiation"
      ],
      "description": "Which offer the fan actually purchased (set when purchased=true)."
    },
    "purchased": {
      "type": "boolean",
      "default": false,
      "description": "True once the fan unlocked this offer; until then the set stays re-offerable on later turns."
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "creator_profile_id",
    "fan_id",
    "content_set_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}