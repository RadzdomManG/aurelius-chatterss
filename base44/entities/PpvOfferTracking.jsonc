{
  "name": "PpvOfferTracking",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "fan_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "content_set_id": {
      "type": "string",
      "description": "PpvContentSet id when source = set; null for vault offers"
    },
    "message_id": {
      "type": "string",
      "description": "Fanvue message UUID of the sent PPV bubble, used to reconcile unlocks against spending insights"
    },
    "media_uuids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The exact vault media UUIDs attached to this offer, used to dedup so a fan never receives the same locked media twice"
    },
    "source": {
      "type": "string",
      "enum": [
        "set",
        "vault"
      ],
      "default": "set",
      "description": "set = curated PpvContentSet bundle; vault = auto-selected from synced Fanvue vault"
    },
    "folder_name": {
      "type": "string",
      "description": "Vault folder the media was drawn from (auto_vault mode)"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "price_cents": {
      "type": "integer"
    },
    "purchased": {
      "type": "boolean",
      "default": false,
      "description": "True once the fan unlocked this offer; until then the set stays re-offerable on later turns."
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "creator_profile_id",
    "fan_id",
    "content_set_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}