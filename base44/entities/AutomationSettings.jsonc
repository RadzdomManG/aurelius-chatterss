{
  "name": "AutomationSettings",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "max_replies_per_hour": {
      "type": "integer",
      "default": 20
    },
    "min_confidence": {
      "type": "number",
      "default": 0.7
    },
    "ppv_allowed": {
      "type": "boolean",
      "default": true
    },
    "max_ppv_cents": {
      "type": "integer",
      "default": 40000
    },
    "default_ppv_cents": {
      "type": "integer",
      "default": 1200
    },
    "ppv_ladder_enabled": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        1200,
        1500,
        2500,
        5000,
        8000,
        15000,
        25000,
        30000,
        40000
      ],
      "description": "Official base PPV ladder in cents: $12, $15, $25, $50, $80, $150, $250, $300, $400. Minimum rung is $12 (1200); maximum is $400 (40000). Rescue offers may go below $12 down to $7."
    },
    "default_media_uuid": {
      "type": "string",
      "description": "Default vault media UUID to attach to AI-generated PPV offers so content is locked"
    },
    "ppv_min_messages_between_offers": {
      "type": "integer",
      "default": 5
    },
    "ppv_min_minutes_between_offers": {
      "type": "integer",
      "default": 10
    },
    "ppv_warmup_messages": {
      "type": "integer",
      "default": 3,
      "description": "Minimum number of messages in a conversation before any PPV offer is allowed (rapport floor)"
    },
    "ppv_reoffer_days": {
      "type": "integer",
      "default": 2,
      "description": "Days to wait before re-offering an unpurchased content set to the same fan"
    },
    "ppv_source": {
      "type": "string",
      "enum": [
        "curated_sets",
        "auto_vault"
      ],
      "default": "curated_sets",
      "description": "curated_sets = operator-built PpvContentSet bundles; auto_vault = AI picks a folder, backend auto-attaches unseen synced vault media from approved folders (zero manual approval)"
    },
    "vault_allowed_folder_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Vault folders the AI may select from in auto_vault mode. Empty = all synced folders allowed."
    },
    "vault_media_per_offer": {
      "type": "integer",
      "default": 3,
      "description": "Max number of unseen media items to attach per auto-vault PPV offer"
    },
    "ppv_preview_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the first PPV media item is sent to Fanvue as mediaPreviewUuid (shown free as a teaser). When false (default), mediaPreviewUuid is omitted entirely so ALL attached PPV media is locked behind the paywall \u2014 zero free previews."
    },
    "rescue_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, an unpurchased base PPV is automatically re-offered once at a -$5 discount after a random 5-10 minute delay."
    },
    "rescue_discount_cents": {
      "type": "integer",
      "default": 500,
      "description": "Discount applied to the base price for the rescue offer (default $5 = 500 cents). Rescue prices may go below the $12 base floor but never below $7."
    },
    "rescue_min_delay_minutes": {
      "type": "integer",
      "default": 5,
      "description": "Minimum random delay before a rescue offer is sent."
    },
    "rescue_max_delay_minutes": {
      "type": "integer",
      "default": 10,
      "description": "Maximum random delay before a rescue offer is sent."
    },
    "reengagement_enabled": {
      "type": "boolean",
      "default": false
    },
    "reengagement_days_threshold": {
      "type": "integer",
      "default": 7
    },
    "active_hours_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the AI only auto-sends during the configured active-hours window in the creator's timezone"
    },
    "active_hours_start": {
      "type": "string",
      "default": "09:00",
      "description": "Local start of the active-hours window (HH:MM, 24h)"
    },
    "active_hours_end": {
      "type": "string",
      "default": "23:00",
      "description": "Local end of the active-hours window (HH:MM, 24h)"
    },
    "runner_interval_seconds": {
      "type": "integer",
      "default": 30
    },
    "runner_status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "stopped"
      ],
      "default": "stopped"
    },
    "runner_last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner_next_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner_jobs_checked": {
      "type": "integer",
      "default": 0
    },
    "runner_jobs_recovered": {
      "type": "integer",
      "default": 0
    },
    "runner_errors": {
      "type": "integer",
      "default": 0
    },
    "consecutive_send_failures": {
      "type": "integer",
      "default": 0,
      "description": "Running count of consecutive Fanvue send failures; reset to 0 on a successful send. Trips the circuit breaker at circuit_breaker_threshold."
    },
    "circuit_breaker_threshold": {
      "type": "integer",
      "default": 5,
      "description": "Consecutive send failures before the creator is auto-paused for safety"
    }
  },
  "required": [
    "creator_profile_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}