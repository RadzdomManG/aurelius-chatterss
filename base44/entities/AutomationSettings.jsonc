{
  "name": "AutomationSettings",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "max_replies_per_hour": {
      "type": "integer",
      "default": 20
    },
    "min_confidence": {
      "type": "number",
      "default": 0.7
    },
    "ppv_allowed": {
      "type": "boolean",
      "default": true
    },
    "max_ppv_cents": {
      "type": "integer",
      "default": 40000
    },
    "default_ppv_cents": {
      "type": "integer",
      "default": 1200
    },
    "ppv_ladder_enabled": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        1000,
        1200,
        1500,
        2500,
        5000,
        10000,
        20000,
        30000,
        40000
      ]
    },
    "default_media_uuid": {
      "type": "string",
      "description": "Default vault media UUID to attach to AI-generated PPV offers so content is locked"
    },
    "ppv_min_messages_between_offers": {
      "type": "integer",
      "default": 5
    },
    "ppv_min_minutes_between_offers": {
      "type": "integer",
      "default": 10
    },
    "reengagement_enabled": {
      "type": "boolean",
      "default": false
    },
    "reengagement_days_threshold": {
      "type": "integer",
      "default": 7
    },
    "runner_interval_seconds": {
      "type": "integer",
      "default": 30
    },
    "runner_status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "stopped"
      ],
      "default": "stopped"
    },
    "runner_last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner_next_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner_jobs_checked": {
      "type": "integer",
      "default": 0
    },
    "runner_jobs_recovered": {
      "type": "integer",
      "default": 0
    },
    "runner_errors": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "creator_profile_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}