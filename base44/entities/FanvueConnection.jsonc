{
  "name": "FanvueConnection",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "external_user_uuid": {
      "type": "string"
    },
    "encrypted_access_token": {
      "type": "string"
    },
    "encrypted_refresh_token": {
      "type": "string"
    },
    "access_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "granted_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "expired",
        "error"
      ],
      "default": "disconnected"
    },
    "last_health_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "idle",
        "syncing",
        "completed",
        "error"
      ],
      "default": "idle"
    },
    "sync_progress": {
      "type": "object"
    },
    "webhook_subscription_id": {
      "type": "string"
    },
    "encrypted_webhook_secret": {
      "type": "string"
    }
  },
  "required": [
    "creator_profile_id"
  ]
}