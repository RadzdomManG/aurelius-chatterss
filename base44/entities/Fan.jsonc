{
  "name": "Fan",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "external_uuid": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "handle": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "nickname": {
      "type": "string",
      "description": "Operator-set nickname shown in the inbox, distinct from the Fanvue display_name"
    },
    "notes": {
      "type": "string",
      "description": "Operator's free-text notes about this fan, shown in the Inspector"
    },
    "subscription_status": {
      "type": "string"
    },
    "automation_paused": {
      "type": "boolean",
      "default": false
    },
    "total_spent_cents": {
      "type": "integer",
      "default": 0
    },
    "online_status": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ],
      "description": "Live presence from the creator.fan.presence_changed webhook"
    },
    "last_online_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this fan was detected online"
    },
    "last_presence_greet_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the bot auto-greeted this fan on presence \u2014 enforces the per-fan cooldown"
    }
  },
  "required": [
    "creator_profile_id",
    "external_uuid",
    "display_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}