{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "fan_id": {
      "type": "string"
    },
    "external_chat_uuid": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "pending"
      ],
      "default": "active"
    },
    "automation_mode_override": {
      "type": "string"
    },
    "unread_count": {
      "type": "integer",
      "default": 0
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string"
    },
    "last_sender_type": {
      "type": "string",
      "enum": [
        "fan",
        "creator",
        "ai",
        "system"
      ]
    },
    "last_topic": {
      "type": "string",
      "description": "Most recent conversation topic detected by AI for continuity"
    },
    "open_loops": {
      "type": "string",
      "description": "Unresolved conversational threads the AI should address"
    },
    "rapport_level": {
      "type": "string",
      "enum": [
        "new",
        "warming",
        "established",
        "close"
      ],
      "default": "new"
    },
    "sales_stage": {
      "type": "string",
      "enum": [
        "rapport",
        "discovery",
        "interest",
        "tease",
        "offer",
        "follow_up"
      ],
      "default": "rapport"
    },
    "last_ppv_offer_at": {
      "type": "string",
      "format": "date-time"
    },
    "ppv_offer_count": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "creator_profile_id",
    "fan_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}