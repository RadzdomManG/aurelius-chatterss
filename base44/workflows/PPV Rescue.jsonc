{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Manila",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ppv_rescue",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "poll_rescues": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "process-rescue-offers",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Poll due rescue offers",
            "description": "Sends discounted re-offers whose timer elapsed"
          }
        }
      }
    ]
  },
  "description": "Polls every 5 minutes for unpurchased base PPV offers whose rescue timer has elapsed, then sends the one-time discounted re-offer with the same locked content.",
  "name": "PPV Rescue"
}