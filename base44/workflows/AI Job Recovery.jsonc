{
  "name": "AI Job Recovery",
  "description": "Every 5 minutes, recovers stuck AI jobs and reprocesses stale pending jobs so no fan message goes unanswered if the webhook request ends mid-processing or a Grok call hangs.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Manila",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_job_recovery",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "recover": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recover-ai-jobs"
          },
          "then": "end",
          "x-base44": {
            "title": "Recover stuck AI jobs",
            "description": "Re-queue processing > 2min + stale pending > 15s"
          }
        }
      }
    ]
  }
}