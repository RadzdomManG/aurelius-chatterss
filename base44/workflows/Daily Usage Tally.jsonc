  "name": "Daily Usage Tally",
  "description": "Runs daily at 2am to tally each organization's monthly AI jobs, messages sent, and creators connected into a UsageRecord. Also processes trial expiry.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_usage_tally",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tally_usage": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "tally-org-usage",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Tally org usage",
            "description": "Count AI jobs, messages, creators per org"
          }
        }
      }
    ]
  }
